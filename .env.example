# S3 Destination Bucket (leave empty to output to the same bucket where the PDF was uploaded)
OUTPUT_S3_BUCKET=my-pdf-converted-bucket

# S3 Folder / Prefix for converted DOCX files
OUTPUT_PREFIX=converted/

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# AWS Region
AWS_REGION=us-east-1

# Optional: Temp directory for scratch conversion files (defaults to /tmp)
TEMP_DIR=/tmp
