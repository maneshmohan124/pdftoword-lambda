# S3 Destination Bucket for converted DOCX files
OUTPUT_S3_BUCKET=qtreeclassreplica

# S3 Folder / Prefix for converted DOCX files (e.g. converted/ or leave empty for root)
OUTPUT_PREFIX=converted/

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# AWS Region where Lambda and Buckets reside
AWS_REGION=us-east-1

# Optional: Temp directory for scratch conversion files (defaults to /tmp in Lambda)
TEMP_DIR=/tmp
